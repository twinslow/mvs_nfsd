#!/usr/bin/expect -f
#
# mvs_upload.expect - Upload source files to MVS PDS libraries.
#
# Usage (from project root):
#   chmod +x mvs_upload.expect
#   ./mvs_upload.expect [incremental]
#
# Options:
#   incremental    Only upload files whose modification time is newer than
#                  the timestamp recorded at the end of the previous run.
#                  On the very first run (no timestamp file yet) all files
#                  are uploaded and a timestamp file is created.
#                  Without this option every matching file is always uploaded.
#
# Note: a leading '-' is intentionally omitted from the option name.
#   Expect's interpreter intercepts single-dash flags before the script
#   sees them: '-incremental' is parsed as Expect's own '-i' flag, leaving
#   'remental' as an unrecognised Tcl command.  Using a plain word avoids
#   this entirely.
#
# What it does:
#   1. Prompts for TSO userid and password (password is not echoed).
#   2. Connects to the MVS FTP server at localhost:2121 in passive mode.
#   3. Sets ASCII transfer mode (required for text files on MVS).
#   4. For each entry in the upload_jobs list: CDs to the target PDS
#      and uploads all matching files from the specified local directory.
#
# Adding a new PDS upload:
#   Add one line to the upload_jobs list in the Configuration section:
#     [list <local-dir> <glob-pattern> <target-pds>]
#   Example:
#     [list [file join $script_dir jcl] "*.jcl" "/TEMP.DINONFS.CNTL"]
#
# Member name derivation:
#   The local filename extension is stripped, the result is uppercased,
#   any characters not valid in MVS member names are removed
#   (valid set: A-Z 0-9 @ # $), and the result is truncated to 8
#   characters.  A warning is printed for any name that is truncated or
#   that becomes empty after cleanup.
#
# Example mappings:
#   nfsd.c               -> NFSD
#   fhandle.c            -> FHANDLE
#   ispf_to_unix_epoch.c -> ISPFTOUN  (truncated -- warned)
#   vfsmvsx.c            -> VFSMVSX
#   types.h              -> TYPES
#

# -----------------------------------------------------------------------
# Configuration
# -----------------------------------------------------------------------
set ftp_host  "192.168.1.168"
set ftp_port  "2121"

set script_dir     [file dirname [file normalize [info script]]]
set asm_dir        [file join $script_dir src]
set src_dir        [file join $script_dir src]
set jcl_dir        [file join $script_dir jcl]
set tests_dir      [file join $script_dir tests]
set tests_jcl_dir  [file join $script_dir tests-jcl]

# Raw FTP client/server dialogue is written here (not echoed to the screen)
# so it is available for diagnosis if a transfer fails.
set ftp_log        [file join $script_dir .mvs_upload_ftp.log]

#
# Upload job list.  Each entry is a three-element list:
#   1. Local source directory (absolute path)
#   2. Glob pattern selecting which files to upload
#   3. Target MVS PDS (absolute FTP path)
#
# Add, remove or reorder entries here -- no other changes are needed.
#
set upload_jobs [list \
    [list $src_dir "*.c" "/TONYW.DINONFS.C"] \
    [list $src_dir "*.asm" "/TONYW.DINONFS.ASM"] \
    [list $src_dir "*.h" "/TONYW.DINONFS.H"] \
    [list $jcl_dir "*.jcl" "/TONYW.DINONFS.CNTL"] \
    [list $tests_dir "*.c" "/TONYW.DINONFS.TESTS.C"] \
    [list $tests_dir "*.h" "/TONYW.DINONFS.TESTS.H"] \
    [list $tests_jcl_dir "*.jcl" "/TONYW.DINONFS.TESTS.CNTL"] \
]

# Seconds to wait for each FTP response before declaring a timeout
set timeout 60

# -----------------------------------------------------------------------
# Command-line argument parsing
# -----------------------------------------------------------------------
set g_incremental 0
foreach arg $argv {
    if {$arg eq "incremental"} {
        set g_incremental 1
    } else {
        send_user "Error: unknown argument: $arg\n"
        send_user "Usage: mvs_upload.expect \[incremental\]\n"
        send_user "  incremental   Only upload files changed since the last run.\n"
        exit 1
    }
}

# -----------------------------------------------------------------------
# Last-run timestamp tracking
#
# The timestamp file records the wall-clock time at the START of the
# most recently completed upload.  Using the start time (rather than the
# end time) guarantees that any file modified *during* a run is caught by
# the next -incremental run.
#
# The file contains a single integer: seconds since the Unix epoch, as
# returned by Tcl's [clock seconds].
# -----------------------------------------------------------------------
set timestamp_file [file join $script_dir .mvs_upload_lastrun]
set g_last_run_time 0

if {$g_incremental} {
    if {[file exists $timestamp_file]} {
        if {[catch {
            set _fh  [open $timestamp_file r]
            set _raw [string trim [read $_fh]]
            close $_fh
            if {[string is integer -strict $_raw] && $_raw > 0} {
                set g_last_run_time $_raw
            } else {
                send_user "Warning: timestamp file is corrupt -- uploading all files.\n"
            }
        } _err]} {
            send_user "Warning: cannot read timestamp file ($_err) -- uploading all files.\n"
        }
    } else {
        send_user "Note: no previous run recorded -- uploading all files.\n"
    }
}

# Snapshot the start time now; written to the timestamp file after the
# upload completes so that future -incremental runs have a reference point.
set g_run_start_time [clock seconds]

# -----------------------------------------------------------------------
# Procedure: member_name
#
# Derive an MVS PDS member name from a local file path.
# Returns the member name string, or "" if no valid characters remain.
# Sets the caller's 'truncated_var' to 1 if the name was truncated.
# -----------------------------------------------------------------------
proc member_name {filepath truncated_var} {
    upvar $truncated_var truncated
    set truncated 0

    # Strip directory and extension, then uppercase
    set base [file rootname [file tail $filepath]]
    set name [string toupper $base]

    # Remove characters not permitted in MVS member names.
    # Valid: A-Z  0-9  @  #  $
    # First character must be alphabetic or national (@ # $).
    regsub -all {[^A-Z0-9@#$]} $name {} name

    # Detect and apply the 8-character limit
    if {[string length $name] > 8} {
        set truncated 1
        set name [string range $name 0 7]
    }

    return $name
}

# -----------------------------------------------------------------------
# Procedure: filter_changed_files
#
# In -incremental mode, returns only those files from file_list whose
# modification time (file mtime) is strictly greater than g_last_run_time.
# In full-upload mode (g_incremental == 0) or when no previous timestamp
# exists (g_last_run_time == 0) the list is returned unchanged.
#
#   file_list - list of absolute file paths
#
# Returns the filtered list (possibly the same list, possibly empty).
# -----------------------------------------------------------------------
proc filter_changed_files {file_list} {
    global g_incremental g_last_run_time

    if {!$g_incremental || $g_last_run_time == 0} {
        return $file_list
    }

    set changed {}
    foreach f $file_list {
        if {[file mtime $f] > $g_last_run_time} {
            lappend changed $f
        }
    }
    return $changed
}

# -----------------------------------------------------------------------
# Procedure: upload_files
#
# Upload a list of local files to the current FTP directory.
# Prints a status line per file; handles per-file errors without
# aborting the entire transfer.
#
# Returns a two-element list: {count_ok count_errors}
# -----------------------------------------------------------------------
proc upload_files {file_list} {
    global timeout
    set count_ok  0
    set count_err 0

    foreach f $file_list {
        set trunc 0
        set member [member_name $f trunc]

        if {$member eq ""} {
            send_user [format "  %-30s SKIPPED  (no valid MVS chars in name)\n" \
                              [file tail $f]]
            continue
        }

        if {$trunc} {
            send_user [format "  %-30s -> %-8s  (WARNING: name truncated)\n" \
                              [file tail $f] $member]
        } else {
            send_user [format "  %-30s -> %s\n" [file tail $f] $member]
        }

        send "put \"$f\" $member\r"

        #
        # Wait for the ftp> prompt that signals the FTP client has fully
        # processed the command and is ready for the next one.
        #
        # "226 Transfer" is used as the success flag; it can only come
        # from the server's 226 reply and cannot appear in the
        # transfer-statistics line that the FTP client appends afterward.
        # Waiting for ftp> (rather than returning on 226) drains the
        # statistics line and the prompt from the buffer before the next
        # put is sent.
        #
        set ok 0
        expect {
            "226 Transfer" { set ok 1; exp_continue }
            -re {ftp> ?$}  { }
            timeout {
                send_user "         *** TIMEOUT uploading [file tail $f] ***\n"
                set ok -1
            }
        }

        if {$ok == 1} {
            incr count_ok
        } elseif {$ok == 0} {
            send_user "         *** ERROR: [file tail $f] -> $member transfer failed ***\n"
            incr count_err
        }
        # ok == -1 is a timeout, already reported above
    }

    return [list $count_ok $count_err]
}

# -----------------------------------------------------------------------
# Procedure: upload_pds
#
# Glob files from a local directory, CD to an MVS PDS, and upload them.
#
#   src_dir   - local directory to read files from
#   glob_pat  - glob pattern selecting files (e.g. "*.c")
#   pds       - MVS PDS FTP path to upload into (e.g. "/TEMP.DINONFS.C")
#
# Handles the CD and reports the section header.  On a CD failure the
# procedure returns an error count equal to the number of matched files
# (all files counted as failed) rather than calling exit, so the main
# loop can report a complete summary before finishing.
#
# Returns a two-element list: {count_ok count_errors}
# -----------------------------------------------------------------------
proc upload_pds {src_dir glob_pat pds} {
    global timeout

    set all_files [lsort [glob -nocomplain -directory $src_dir $glob_pat]]
    set files     [filter_changed_files $all_files]

    if {[llength $all_files] == 0} {
        send_user -- "--- $glob_pat -> $pds (no matching files, skipping) ---\n\n"
        return [list 0 0]
    }

    if {[llength $files] == 0} {
        send_user -- "--- $glob_pat -> $pds (no changed files, skipping) ---\n\n"
        return [list 0 0]
    }

    send_user -- "--- $glob_pat -> $pds ([llength $files] of [llength $all_files] file(s)) ---\n"

    # CD to the target PDS and drain the ftp> prompt before sending puts
    send "cd $pds\r"
    expect {
        "250 " { expect -re {ftp> ?$} }
        -re {5[0-9][0-9] } {
            send_user "Error: cannot cd to $pds\n"
            send_user "       Check that the PDS exists and you have write access.\n"
            send_user "\n"
            return [list 0 [llength $files]]
        }
        timeout {
            send_user "Error: timeout on cd to $pds\n"
            send_user "\n"
            return [list 0 [llength $files]]
        }
    }

    set counts [upload_files $files]
    send_user "\n"
    return $counts
}

# -----------------------------------------------------------------------
# Pre-flight: validate source directories and count total / changed files
# -----------------------------------------------------------------------
set total_files   0
set total_changed 0
foreach job $upload_jobs {
    set jdir [lindex $job 0]
    set jpat [lindex $job 1]
    if {![file isdirectory $jdir]} {
        send_user "Error: source directory not found: $jdir\n"
        exit 1
    }
    set jfiles [glob -nocomplain -directory $jdir $jpat]
    incr total_files   [llength $jfiles]
    incr total_changed [llength [filter_changed_files $jfiles]]
}

if {$total_files == 0} {
    send_user "Error: no files found matching any upload job.\n"
    exit 1
}

if {$g_incremental && $total_changed == 0} {
    set _when [clock format $g_last_run_time -format {%Y-%m-%d %H:%M:%S}]
    send_user "Incremental mode: no files changed since $_when.\n"
    send_user "Nothing to upload.\n"
    exit 0
}

# -----------------------------------------------------------------------
# Banner
# -----------------------------------------------------------------------
send_user "\n"
send_user "MVS source upload\n"
send_user "=================\n"
send_user "FTP target : $ftp_host:$ftp_port\n"
send_user "FTP log    : $ftp_log\n"
if {$g_incremental} {
    send_user "Mode       : incremental\n"
    if {$g_last_run_time > 0} {
        send_user "Last run   : [clock format $g_last_run_time -format {%Y-%m-%d %H:%M:%S}]\n"
    } else {
        send_user "Last run   : (none -- uploading all files)\n"
    }
} else {
    send_user "Mode       : full upload\n"
}
send_user "Jobs       :\n"
foreach job $upload_jobs {
    set jdir  [lindex $job 0]
    set jpat  [lindex $job 1]
    set jpds  [lindex $job 2]
    set jall  [glob -nocomplain -directory $jdir $jpat]
    set jtot  [llength $jall]
    set jn    [llength [filter_changed_files $jall]]
    if {$g_incremental} {
        send_user [format "  %-8s %-35s -> %s (%d of %d file(s) changed)\n" \
                          $jpat $jdir $jpds $jn $jtot]
    } else {
        send_user [format "  %-8s %-35s -> %s (%d file(s))\n" \
                          $jpat $jdir $jpds $jn]
    }
}
if {$g_incremental} {
    send_user "Total      : $total_changed of $total_files file(s) changed\n"
} else {
    send_user "Total      : $total_files file(s)\n"
}
send_user "\n"

# -----------------------------------------------------------------------
# Credentials -- environment variables take priority over interactive input
# -----------------------------------------------------------------------
if {[info exists env(MVS_USERID)] && $env(MVS_USERID) ne ""} {
    set userid $env(MVS_USERID)
    send_user "TSO userid : $userid (from \$MVS_USERID)\n"
} else {
    send_user "TSO userid : "
    expect_user -re "(.*)\n"
    set userid [string trim $expect_out(1,string)]
    if {$userid eq ""} {
        send_user "Error: userid cannot be empty.\n"
        exit 1
    }
}

if {[info exists env(MVS_PASSWORD)] && $env(MVS_PASSWORD) ne ""} {
    set password $env(MVS_PASSWORD)
    send_user "Password   : (from \$MVS_PASSWORD)\n"
} else {
    send_user "Password   : "
    stty -echo
    expect_user -re "(.*)\n"
    set password $expect_out(1,string)
    stty echo
    send_user "\n"
}
send_user "\n"

# -----------------------------------------------------------------------
# Quiet the FTP dialogue
#
# The raw FTP conversation is noisy, so keep it OFF the screen (log_user 0)
# and record it in a log file instead.  Only this script's own progress and
# error messages (send_user, unaffected by log_user) still appear on screen;
# the log file is there for post-mortem diagnosis when a transfer fails.
# The password is sent to the FTP client, which suppresses its echo, so it is
# not captured in the log.
# -----------------------------------------------------------------------
# -a       : log the dialogue even though log_user 0 hides it from the screen
#            (without -a, log_file records nothing while log_user is 0).
# -noappend: truncate, so the log reflects only the current run.
log_user 0
if {[catch {log_file -a -noappend $ftp_log} _err]} {
    send_user "Warning: cannot open FTP log $ftp_log ($_err) -- continuing.\n"
} else {
    send_log "===== FTP upload session [clock format [clock seconds] -format {%Y-%m-%d %H:%M:%S}] =====\n"
}

# -----------------------------------------------------------------------
# Spawn FTP  (-p = passive mode,  host  port)
# -----------------------------------------------------------------------
send_user "Connecting to $ftp_host port $ftp_port ...\n"
spawn ftp -p $ftp_host $ftp_port

expect {
    -re {[Nn]ame.*:[ \t]*}  { }
    -re {[Uu]ser.*:[ \t]*}  { }
    timeout {
        send_user "Error: FTP server did not present a login prompt.\n"
        exit 1
    }
}
send "$userid\r"

expect {
    -re {[Pp]assword.*:[ \t]*} { }
    timeout {
        send_user "Error: FTP server did not present a password prompt.\n"
        exit 1
    }
}
send "$password\r"

expect {
    "230 " { send_user "Logged in as $userid.\n\n" }
    "530 " { send_user "Error: login failed -- check userid and password (see $ftp_log).\n"; exit 1 }
    timeout { send_user "Error: timeout waiting for login confirmation (see $ftp_log).\n";   exit 1 }
}

# -----------------------------------------------------------------------
# Set ASCII transfer mode
# -----------------------------------------------------------------------
send "ascii\r"
expect {
    "200 " { expect -re {ftp> ?$} }
    timeout { send_user "Warning: no confirmation for ASCII mode -- continuing anyway.\n" }
}

# -----------------------------------------------------------------------
# Run each upload job
# -----------------------------------------------------------------------
set total_ok  0
set total_err 0

foreach job $upload_jobs {
    set result [upload_pds [lindex $job 0] [lindex $job 1] [lindex $job 2]]
    incr total_ok  [lindex $result 0]
    incr total_err [lindex $result 1]
}

# -----------------------------------------------------------------------
# Save the run timestamp for future -incremental runs
# -----------------------------------------------------------------------
if {[catch {
    set _fh [open $timestamp_file w]
    puts $_fh $g_run_start_time
    close $_fh
} _err]} {
    send_user "Warning: could not save run timestamp ($_err).\n"
    send_user "         Next -incremental run will upload all files.\n"
}

# -----------------------------------------------------------------------
# Disconnect and summarise
# -----------------------------------------------------------------------
send "quit\r"
expect eof

send_user "=================\n"
send_user "Upload complete.\n"
send_user "  Succeeded : $total_ok file(s)\n"
if {$total_err > 0} {
    send_user "  Failed    : $total_err file(s)\n"
    send_user "  FTP log   : $ftp_log (full dialogue for diagnosis)\n"
}
send_user "\n"

if {$total_err > 0} { exit 1 }
exit 0
